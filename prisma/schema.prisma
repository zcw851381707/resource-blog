generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  email            String?   @unique
  avatar           String?
  password         String
  role             String    @default("user")   // user | admin
  status           String    @default("active") // active | banned
  mutedUntil       DateTime?
  mutedReason      String?    // 禁言原因/通知文案
  lastLoginAt      DateTime?
  profileChangedAt DateTime?  // 用户名/头像上次修改时间；注册 30 天内可改一次，之后每 180 天一次
  gender           String?    // male | female | other
  birthday         DateTime?  // 生日
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model BannedWord {
  id        String   @id @default(uuid())
  word      String   @unique
  createdAt DateTime @default(now())
}

model InviteCode {
  id        String    @id @default(uuid())
  code      String    @unique
  createdBy String
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model EmailCode {
  id        String    @id @default(uuid())
  email     String
  code      String
  purpose   String    // register | reset
  used      Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  ip        String?
}

model DownloadLink {
  id          String   @id @default(uuid())
  platform    String
  url         String
  extractCode String?
  label       String?
  dramaId     String
  createdAt   DateTime @default(now())
  drama       Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
}

model Drama {
  id                String         @id @default(uuid())
  title             String
  slug              String         @unique
  coverImage        String?
  description       String?
  region            String?
  tags              String?
  category          String         @default("tv")
  isOnSchedule      Boolean        @default(false)
  isNewlyAired      Boolean        @default(false)
  isUpcoming        Boolean        @default(false)
  airDays           String?
  pausedDays        String?
  isSuspended       Boolean        @default(false)
  airTime           String?
  expectedDate      DateTime?
  expectedPrecision String?        @default("day")
  totalEpisodes     Int?
  currentEpisode    Int?
  manualEpisode     Int?
  isCompleted       Boolean        @default(false)
  startDate         DateTime?
  updateFrequency   String?
  sortOrder         Int            @default(0)
  clickCount        Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?
  videoUrl          String?
  videoLabel        String?
  seriesGroup       String?
  seriesOrder       Int?           @default(0)
  episodesPerDay    Int?           @default(1)
  premiereEpisodes  Int?
  notifiedAt        DateTime?
  lastEpisodeUpdate DateTime?
  imagePosition     String?        @default("center")
  originalTitle     String?        @default("")
  scheduleImage     String?
  galleryImages     String?
  downloadLinks     DownloadLink[]
  linkReports       LinkReport[]
}

model Banner {
  id            String   @id @default(uuid())
  title         String
  subtitle      String?
  highlightWord String?
  image         String?
  mediaType     String   @default("image")
  videoUrl      String?
  videoPoster   String?
  videoDuration Int?
  gradientFrom  String   @default("#C8283C")
  gradientTo    String   @default("#DC6464")
  buttonText    String?
  buttonLink    String?
  bannerLink    String?
  showButton    Boolean  @default(false)
  isPortrait    Boolean  @default(false)
  portraitImages String?
  isAd           Boolean  @default(false)
  adLabel        String?  // 自定义标签文字，如"推广"、"广告"、"赞助"
  titleFont      String?  // 标题字体，null=自动选择
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  dramaId       String?
  description   String?
  imagePosition String?  @default("center")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(uuid())
  content   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(uuid())
  name      String
  icon      String
  url       String?
  qrCode    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id               String   @id @default(uuid())
  tipQRCode        String?
  tipButtonText    String   @default("打赏")
  publicAccountImg String?
  updatedAt        DateTime @updatedAt
  larkWebhookUrl   String?
  larkAppId        String?
  larkAppSecret    String?
  larkChatId       String?
}

model VisitLog {
  id        String   @id @default(uuid())
  path      String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ResourceRequest {
  id              String   @id @default(uuid())
  name            String
  type            String   @default("request")
  description     String?
  contact         String?
  email           String?
  linkUrl         String?
  linkExtractCode String?
  likes           Int      @default(0)
  reply           String?
  isProcessed     Boolean  @default(false)
  isPublic        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Article {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  coverImage  String?
  excerpt     String?
  dramaTitle  String?
  wechatUrl   String?
  isPublished   Boolean   @default(false)
  pinned        Boolean   @default(false)
  publishedAt   DateTime?
  imagePosition String?   @default("center")
  viewCount     Int       @default(0)
  likes         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LinkReport {
  id           String   @id @default(uuid())
  dramaId      String
  linkId       String
  linkPlatform String
  issueType    String?
  note         String?
  email        String?
  ip           String?
  isProcessed  Boolean  @default(false)
  createdAt    DateTime @default(now())
  drama        Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  dramaId   String
  createdAt DateTime @default(now())

  @@unique([userId, dramaId])
  @@index([userId])
  @@index([dramaId])
}

model UserFollowing {
  id        String   @id @default(uuid())
  userId    String
  dramaId   String
  // watching = 追剧中, planned = 想看, completed = 已看完, dropped = 弃剧
  status    String   @default("watching")
  progress  Int      @default(0) // 用户标记的看到第几集
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dramaId])
  @@index([userId])
  @@index([dramaId])
  @@index([userId, status])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  dramaId   String
  // 1-5 星
  score     Int
  updateCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dramaId])
  @@index([dramaId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  dramaId   String
  content   String
  flag      String   @default("clean") // clean=正常  suspicious=可疑  toxic=已清除
  // 软删除
  isDeleted Boolean  @default(false)
  // 父评论 id（回复某条评论时填写；顶级评论为 null）
  parentId  String?
  // 被回复用户名（冗余，避免被删除后丢失线索）
  replyToUser String?
  // 精选置顶（管理员）
  pinned   Boolean   @default(false)
  // 点赞数（冗余字段，避免每次 count）
  likeCount Int      @default(0)
  // 回复数（冗余字段）
  replyCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dramaId, createdAt])
  @@index([userId])
  @@index([flag, createdAt])
  @@index([parentId])
  @@index([dramaId, pinned])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
}

model DramaSubscription {
  id        String    @id @default(uuid())
  userId    String
  dramaId   String
  notified  Boolean   @default(false)
  notifiedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dramaId])
  @@index([userId])
  @@index([dramaId])
}

model MonthlyReport {
  id              String   @id @default(uuid())
  userId          String
  year            Int
  month           Int
  totalEpisodes   Int      @default(0)
  totalDramas     Int      @default(0)
  completedDramas Int      @default(0)
  topDramaId      String?
  topGenre        String?
  generatedAt     DateTime @default(now())

  @@unique([userId, year, month])
}

model DailyRanking {
  id        String   @id @default(uuid())
  rank      Int
  dramaId   String
  date      String   // YYYY-MM-DD
  isTop10   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([dramaId, date])
  @@index([date, rank])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  event     String
  props     String?
  page      String?
  ip        String?
  ua        String?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   // 接收者
  type      String   // ANNOUNCEMENT | MUTE
  title     String   // 通知标题
  content   String   // 通知内容
  // 关联来源（公告 id / 禁言记录）
  refId     String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  icon        String
  condition   String
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

